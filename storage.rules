rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'payefatou97@gmail.com',
          'adamambacke19@gmail.com'
        ];
    }

    match /courses/{courseId}/{fileName} {
      allow read: if isAdmin()
        || (signedIn()
          && firestore.get(/databases/(default)/documents/courses/$(courseId)).data.published == true);
      allow create: if isAdmin()
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('(audio|video)/.*|application/pdf');
      allow update, delete: if isAdmin();
    }
  }
}
